# Runtime
NODE_ENV=development
PORT=3000
APP_ORIGIN=

# Authentication
# Use a long random value in every deployed environment.
AUTH_SECRET=replace-with-a-long-random-production-secret
# Used only to access seeded persona accounts in development/demo mode.
DEMO_MODE=true
DEMO_PASSWORD=demo1234

# Set STORAGE_DRIVER=sqlite for transactional local/early production persistence.
# Leave unset to retain the current JSON store during migration.
STORAGE_DRIVER=json
DATABASE_URL=file:./data/pgsaathi.db

# Optional Gemini integration. The product has a grounded local fallback when absent.
GEMINI_API_KEY=

# Optional Razorpay integration. When both values are present, server-side order
# creation uses Razorpay; otherwise the explicitly-labelled mock provider is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
