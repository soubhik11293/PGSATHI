# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Mode configuration: When true, enables rich simulated payments, mock emails, and fallback responses
DEMO_MODE=true

# Database connection URL (supports SQLite / PostgreSQL)
DATABASE_URL="file:./data/pgsaathi.db"

# Session / JWT Auth secret
AUTH_SECRET="pg-saathi-super-secret-jwt-key-2026"

# Google Maps / Location API Key
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Razorpay / UPI Integration Keys
RAZORPAY_KEY_ID="rzp_test_sampleKeyId"
RAZORPAY_KEY_SECRET="rzp_test_sampleSecret"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_key"

# Resend / Email notifications
RESEND_API_KEY="re_sampleApiKey"

# Media storage service
STORAGE_URL="https://storage.googleapis.com/pg-saathi-media"
STORAGE_API_KEY="my_storage_key"
